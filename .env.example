# Local development settings for the web app (copy to .env.local).
# Production values come from /srv/kibrisikincielcim/.env (deploy/.env.example)
# and are compiled into the web image at build time.

# Used for canonical URLs, sitemap and e-mail links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Realtime (chat, notifications); in production the site's own wss://…/api/v1/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/v1/ws

# Where the Next.js server reaches the API (server side only)
API_INTERNAL_URL=http://127.0.0.1:4000
# Same value as INTERNAL_API_TOKEN in api/.env (lets the API trust the client IP we forward)
INTERNAL_API_TOKEN=

# Optional contact e-mail shown on legal pages (the support form is used otherwise)
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense — leave empty until the site is approved
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
# 1 only after a certified consent message (Google Privacy & messaging) is live
NEXT_PUBLIC_ADSENSE_CMP_READY=0

# Google sign-in button (the API needs GOOGLE_CLIENT_ID/SECRET too)
NEXT_PUBLIC_AUTH_GOOGLE=0
