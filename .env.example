# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used for canonical URLs, sitemap and auth e-mail links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed to run `npm run seed` (never exposed to the browser)
SUPABASE_SECRET_KEY=sb_secret_xxx
SEED_PASSWORD=choose-a-demo-password

# Optional contact e-mail shown on legal pages (support form is used otherwise)
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense — leave empty until the site is approved
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# Sign-in methods that need outside setup (1 = on)
NEXT_PUBLIC_AUTH_GOOGLE=0
NEXT_PUBLIC_AUTH_PHONE=0

# Local development only: scripts that write to the database (seed, e2e,
# security, integration) refuse to run unless ALLOW_DESTRUCTIVE_TESTS=1, the
# Supabase project ref matches DEV_SUPABASE_PROJECT_REF and NEXT_PUBLIC_SITE_URL
# is localhost. Never set these in a production environment.
ALLOW_DESTRUCTIVE_TESTS=
DEV_SUPABASE_PROJECT_REF=
