{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "security": "npm run security:p0 && npm run security:p1",
    "security:p0": "node --env-file=.env.local scripts/security-check.mjs",
    "security:p1": "node --env-file=.env.local scripts/security-p1-check.mjs",
    "integration": "node --env-file=.env.local scripts/integration-check.mjs",
    "e2e": "node --env-file=.env.local scripts/e2e-check.mjs",
    "responsive": "node --env-file=.env.local scripts/responsive-check.mjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "smoke": "node scripts/production-smoke.mjs",
    "smoke:local": "node --env-file=.env.local scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
