[Unit]
Description=Kıbrıs İkinci Elcim: weekly restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/srv/kibrisikincielcim/ops.env
ExecStart=/usr/bin/env bash /srv/kibrisikincielcim/app/deploy/ops/restore-test.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
