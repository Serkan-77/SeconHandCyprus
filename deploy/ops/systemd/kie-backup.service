[Unit]
Description=Kıbrıs İkinci Elcim: nightly database and uploads backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/srv/kibrisikincielcim/ops.env
ExecStart=/usr/bin/env bash /srv/kibrisikincielcim/app/deploy/ops/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
