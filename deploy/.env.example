# Copy to /srv/kibrisikincielcim/.env on the server, fill in, then:
#   chmod 600 /srv/kibrisikincielcim/.env
# Generate secrets with:  openssl rand -hex 32
# Never commit the filled-in file.

# Public origin (https, no trailing slash). Staging: the temporary hostname.
SITE_URL=https://www.kibrisikincielcim.com
# Other origins allowed to send cookie-authenticated writes and WebSocket
# handshakes (comma separated). Production: the direct VDS hostname.
EXTRA_ORIGINS=https://new.kibrisikincielcim.com
COOKIE_DOMAIN=

# PostgreSQL (only used inside the Docker networks)
POSTGRES_SUPERUSER_PASSWORD=
KIE_OWNER_PASSWORD=
KIE_APP_PASSWORD=

# API secrets
JWT_SECRET=
INTERNAL_API_TOKEN=

# Transactional e-mail (required: verification and password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0
MAIL_FROM=Kıbrıs İkinci Elcim <no-reply@kibrisikincielcim.com>

# Google sign-in (optional). Create an OAuth client (Web application) in
# Google Cloud with the redirect URI <SITE_URL>/api/v1/auth/google/callback.
# Set both values AND NEXT_PUBLIC_AUTH_GOOGLE=1 (then rebuild web) to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=0

# Host paths and ports (defaults shown)
KIE_DATA_DIR=/srv/kibrisikincielcim/data
KIE_UPLOAD_DIR=/srv/kibrisikincielcim/uploads
KIE_BACKUP_DIR=/srv/kibrisikincielcim/backups
KIE_API_PORT=4100
KIE_WEB_PORT=3100

# Public build-time options
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_CMP_READY=0
