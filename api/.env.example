# Local development settings for the API (copy to api/.env). Production
# values live in /srv/kibrisikincielcim/.env on the server (deploy/.env.example).
# The database passwords below are the placeholders of docker-compose.dev.yml.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://kie_app:dev-app-password@127.0.0.1:55432/kibrisikincielcim
DATABASE_OWNER_URL=postgres://kie_owner:dev-owner-password@127.0.0.1:55432/kibrisikincielcim
SITE_URL=http://localhost:3000
# openssl rand -hex 32 (twice); INTERNAL_API_TOKEN must match the web's .env.local
JWT_SECRET=
INTERNAL_API_TOKEN=
TRUST_PROXY_HOPS=1
UPLOAD_DIR=./data/uploads
SERVE_MEDIA=1
# "log" prints e-mails (with their links) to the console instead of sending
MAIL_TRANSPORT=log
LOG_LEVEL=info
# npm run seed: demo accounts (…@demo.kibrisikincielcim.test) use this password
SEED_ALLOW=1
SEED_PASSWORD=
# Optional: Google sign-in (see docs/DEPLOYMENT.md §8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
