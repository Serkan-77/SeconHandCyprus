{
  "name": "kie-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
