# Production environment — template only. Real values go into the hosting
# provider's environment settings (or a local .env.production.local for a
# one-off smoke test); never into this file or any committed file.
# Full guide: docs/PRODUCTION_DEPLOYMENT.md

# --- Required ---------------------------------------------------------------
# The PRODUCTION Supabase project (never the development project):
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<production-project-ref>.supabase.co
# The publishable ("sb_publishable_…") key. It is sent to every browser; the
# build refuses a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<replace>
# Public origin of the site: https, no path, no trailing slash. Used for
# canonical URLs, sitemap, robots.txt and auth e-mail links. The production
# build fails when it is missing or not https.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# --- Optional ---------------------------------------------------------------
# Contact address shown on legal pages (the support form is used otherwise).
NEXT_PUBLIC_CONTACT_EMAIL=
# Sign-in methods that need outside setup (1 = on). Turn Google on only after
# the Google provider and its callback URL are configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=0
NEXT_PUBLIC_AUTH_PHONE=0

# --- Google AdSense (off) -----------------------------------------------------
# The client id alone only enables the site-review meta tag and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
# Keep 0 until a Google-certified consent message (CMP) is published and
# tested. Only then set 1: ad script, ad slots and ad CSP hosts turn on.
NEXT_PUBLIC_ADSENSE_CMP_READY=0

# --- Not used in production ---------------------------------------------------
# The running site needs no server secret. Do NOT set these in production:
#   SUPABASE_SECRET_KEY      (only local seed/test scripts use it)
#   SEED_PASSWORD            (demo accounts; never seed production)
#   ALLOW_DESTRUCTIVE_TESTS  (must stay unset: database-writing scripts refuse
#   DEV_SUPABASE_PROJECT_REF  to run without it and against non-localhost sites)
