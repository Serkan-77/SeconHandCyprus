# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.production.example
e2e-screens/
responsive-shots/

# marketplace-v2: API service, local data and deploy secrets
/api/node_modules
/api/dist
/api/data
/api/.env
/migration/node_modules
/migration/out
/deploy/.env*
!/deploy/.env.example
/deploy/secrets/
*.sql.gz
*.dump

# Migration rehearsal output
/.rehearsal
